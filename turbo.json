{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "start": {
            "dependsOn": ["build"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "type-check": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "tests/**"],
            "outputs": ["coverage/**"]
        },
        "test:e2e": {
            "dependsOn": ["build"]
        }
    }
}
