# FeedFlow — Environment Variables
# Copy to .env.local and fill in values

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Upstash Redis ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Cloudflare Images ────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_IMAGES_TOKEN=your-images-token
NEXT_PUBLIC_CLOUDFLARE_IMAGES_HASH=your-hash

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=FeedFlow <noreply@feedflow.app>

# ─── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-org
SENTRY_PROJECT=feedflow
SENTRY_AUTH_TOKEN=sntrys_...

# ─── PostHog ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Stripe Price IDs ─────────────────────────────────────────────────────────
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...

# ─── Mux (live video) ─────────────────────────────────────────────────────────
MUX_ACCESS_TOKEN_ID=your-mux-token-id
MUX_SECRET_KEY=your-mux-secret-key

# ─── LiveKit (WebRTC) ─────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ─── Cloudflare Images (API token) ───────────────────────────────────────────
CLOUDFLARE_IMAGES_API_TOKEN=your-cloudflare-images-api-token
