{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "plugins": [{ "name": "next" }],
        "paths": {
            "@/*": ["./*"],
            "feed_mfe/*": ["./__federation_types__/feed_mfe/*"],
            "messages_mfe/*": ["./__federation_types__/messages_mfe/*"],
            "notifications_mfe/*": ["./__federation_types__/notifications_mfe/*"],
            "profile_mfe/*": ["./__federation_types__/profile_mfe/*"]
        }
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
}
